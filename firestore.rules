rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A "board" is one private space (its random id lives in the ?board= URL).
    // It holds your lists and tasks. Keep the URL private.
    function validBoard(boardId) {
      return boardId.size() >= 30 && boardId.size() <= 80;
    }

    match /boards/{boardId} {

      // -------- Lists --------
      match /lists/{listId} {
        allow read, delete: if validBoard(boardId);
        allow create, update: if validBoard(boardId)
          && request.resource.data.keys().hasOnly(['name', 'color', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 16
          && request.resource.data.createdAt is int;
      }

      // -------- Tasks --------
      match /tasks/{taskId} {
        allow read, delete: if validBoard(boardId);
        allow create: if validBoard(boardId) && validTask(request.resource.data);
        // Updates may touch any subset of the editable fields.
        allow update: if validBoard(boardId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'notes', 'listId', 'dueDate', 'time',
            'durationMin', 'priority', 'done', 'remindMin', 'repeat', 'subtasks'
          ]);
      }
    }

    // -------- Web Push subscriptions --------
    // Push endpoints are only usable by whoever holds the secret VAPID private
    // key (the scheduler), so storing them here is safe. The scheduler reads
    // them; expired ones are deleted.
    match /pushSubs/{subId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['board', 'endpoint', 'p256dh', 'auth', 'tz', 'createdAt'])
        && request.resource.data.board is string
        && request.resource.data.board.size() >= 30
        && request.resource.data.board.size() <= 80
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() <= 1000
        && request.resource.data.tz is int
        && request.resource.data.createdAt is int;
    }

    // -------- Reminder dedup log --------
    // One doc per (task, fire-time) so the scheduler never sends twice.
    match /reminderLog/{logId} {
      allow read, create: if true;
    }

    function validTask(d) {
      return d.keys().hasOnly([
          'title', 'notes', 'listId', 'dueDate', 'time',
          'durationMin', 'priority', 'done', 'remindMin', 'repeat', 'createdAt', 'subtasks'
        ])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.notes is string && d.notes.size() <= 500
        && d.listId is string && d.listId.size() <= 80
        && d.dueDate is string && d.dueDate.size() <= 10
        && d.time is string && d.time.size() <= 5
        && d.durationMin is int
        && d.priority in ['low', 'med', 'high']
        && d.done is bool
        && d.remindMin is int
        && d.repeat in ['', 'daily', 'weekdays', 'weekly', 'monthly']
        && d.createdAt is int
        && (!('subtasks' in d) || (d.subtasks is list && d.subtasks.size() <= 50));
    }
  }
}
